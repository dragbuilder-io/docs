---
// Ported from orbit-docs (the design-system's own docs site) — same
// component, same tokens, just STRINGS below trimmed to this site's
// actual locales (en/es, no fr).
//
// Full replacement of Starlight's default <Search> — that one wraps
// @pagefind/default-ui's packaged widget, which renders and owns its own
// native <input>/<button> markup internally (its own debounce, result
// rendering, pagination — all baked into the widget, not something you
// can swap pieces out of). This version drops that widget and talks to
// Pagefind's low-level index API directly (the same /pagefind/pagefind.js
// every Starlight+Pagefind site already builds), so the trigger, the
// modal shell, the query field and the "load more" control are all real
// Orbit components — <orbit-modal>, <orbit-text-field>, <orbit-button> —
// not Pagefind's own HTML re-themed to look the part.
import project from "virtual:starlight/project-context";

// Astro.locals.t is typed as i18next's TFunction<'starlight'> — without
// a matching i18next.CustomTypeOptions augmentation (Starlight doesn't
// ship one for consumers), TypeScript falls back to an overload that
// only accepts a tagged-template call, rejecting the plain string keys
// Starlight's own docs (translations.ts) show as the actual usage. The
// keys below are real (translations/en.json) and this is how Starlight's
// own Search.astro calls it too — cast locally rather than fighting
// i18next's generics.
const t = Astro.locals.t as (key: string) => string;
const label = t("search.label");
const ctrlKey = t("search.ctrlKey");
const devWarning = t("search.devWarning");
---

<orbit-search data-strip-trailing-slash={project.trailingSlash === "never"} data-dev-warning={devWarning}>
  <button type="button" data-open-modal disabled aria-label={label} aria-keyshortcuts="Control+K" class="orbit-search-trigger">
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M11 3a8 8 0 1 0 0 16 8 8 0 0 0 0-16z M21 21l-4.35-4.35"></path>
    </svg>
    <span class="placeholder">{label}</span>
    <kbd class="shortcut" style="display: none;"><kbd>{ctrlKey}</kbd><kbd>K</kbd></kbd>
  </button>

  <orbit-modal style="--modal-max-width: 640px;">
    <div class="orbit-search-body">
      <orbit-text-field leading-icon="search" placeholder={label} data-search-input></orbit-text-field>
      <p class="status" data-search-status aria-live="polite"></p>
      <div class="results" data-search-results></div>
      <orbit-button variant="ghost" data-search-load-more hidden></orbit-button>
    </div>
  </orbit-modal>
</orbit-search>

<script>
  import "@dragbuilder-io/orbit/orbit-modal.js";
  import "@dragbuilder-io/orbit/orbit-text-field.js";
  import "@dragbuilder-io/orbit/orbit-button.js";

  type PagefindSubResult = {
    title: string;
    url: string;
    excerpt: string;
  };

  type PagefindResultData = {
    url: string;
    meta: { title?: string };
    excerpt: string;
    sub_results: PagefindSubResult[];
  };

  type PagefindResult = { id: string; data: () => Promise<PagefindResultData> };
  type PagefindSearchResponse = { results: PagefindResult[] } | null;

  type Pagefind = {
    init: () => Promise<void>;
    debouncedSearch: (
      term: string,
      options?: Record<string, unknown>,
      timeout?: number,
    ) => Promise<PagefindSearchResponse>;
  };

  const BATCH_SIZE = 5;

  const STRINGS: Record<
    string,
    {
      resultsFor: (n: number, q: string) => string;
      noResults: (q: string) => string;
      loadMore: string;
      searching: string;
    }
  > = {
    es: {
      resultsFor: (n, q) => `${n} resultado${n === 1 ? "" : "s"} para "${q}"`,
      noResults: (q) => `Sin resultados para "${q}".`,
      loadMore: "Cargar más resultados",
      searching: "Buscando…",
    },
    en: {
      resultsFor: (n, q) => `${n} result${n === 1 ? "" : "s"} for "${q}"`,
      noResults: (q) => `No results for "${q}".`,
      loadMore: "Load more results",
      searching: "Searching…",
    },
  };

  class OrbitSearch extends HTMLElement {
    // Cache the *promise*, not just the resolved module — onInput() runs
    // once per keystroke, so without this every keystroke typed before
    // the first import+init finishes starts its own concurrent
    // import()/init() cycle, racing to reinitialize the same Pagefind
    // WASM instance and corrupting whichever search was mid-flight.
    private pagefindPromise: Promise<Pagefind | null> | null = null;
    private results: PagefindResult[] = [];
    private rendered = 0;
    // Monotonic counter, not the query string — a search this stale
    // could in principle still numerically equal a later one (type
    // "ab", delete to "a", retype "ab"); the counter can't collide.
    private searchSeq = 0;
    private t = STRINGS.en;

    private openBtn!: HTMLButtonElement;
    private modal!: HTMLElement;
    private input!: HTMLElement & { value: string };
    private statusEl!: HTMLElement;
    private resultsEl!: HTMLElement;
    private loadMoreBtn!: HTMLElement;

    constructor() {
      super();
      this.t = STRINGS[document.documentElement.lang] ?? STRINGS.en;
    }

    connectedCallback() {
      this.openBtn = this.querySelector("button[data-open-modal]") as HTMLButtonElement;
      this.modal = this.querySelector("orbit-modal") as HTMLElement;
      this.input = this.querySelector("[data-search-input]") as HTMLElement & { value: string };
      this.statusEl = this.querySelector("[data-search-status]") as HTMLElement;
      this.resultsEl = this.querySelector("[data-search-results]") as HTMLElement;
      this.loadMoreBtn = this.querySelector("[data-search-load-more]") as HTMLElement;

      // Platform-appropriate shortcut hint — same detection Starlight's
      // own Search.astro used (deliberately the deprecated
      // navigator.platform: userAgent is spoofed by some browsers when
      // devtools are open).
      const shortcut = this.openBtn.querySelector("kbd") as HTMLElement;
      const platformKey = shortcut.querySelector("kbd") as HTMLElement;
      if (/(Mac|iPhone|iPod|iPad)/i.test(navigator.platform)) {
        platformKey.textContent = "⌘";
        this.openBtn.setAttribute("aria-keyshortcuts", "Meta+K");
      }
      shortcut.style.display = "";
      this.openBtn.disabled = false;

      this.openBtn.addEventListener("click", () => this.open());
      window.addEventListener("keydown", (event) => {
        if ((event.metaKey || event.ctrlKey) && event.key === "k") {
          event.preventDefault();
          this.modal.hasAttribute("open") ? this.close() : this.open();
        }
      });

      this.input.addEventListener("input", () => this.onInput());
      this.loadMoreBtn.addEventListener("click", () => this.renderNextBatch());
    }

    open() {
      this.modal.setAttribute("open", "");
      requestAnimationFrame(() => (this.input as unknown as HTMLElement).focus?.());
      const inner = this.input.shadowRoot?.querySelector("input");
      inner?.focus();
    }

    close() {
      this.modal.removeAttribute("open");
    }

    ensurePagefind(): Promise<Pagefind | null> {
      if (!this.pagefindPromise) this.pagefindPromise = this.loadPagefind();
      return this.pagefindPromise;
    }

    async loadPagefind(): Promise<Pagefind | null> {
      if (import.meta.env.DEV) {
        this.statusEl.textContent = this.dataset.devWarning ?? "";
        return null;
      }
      try {
        const base = import.meta.env.BASE_URL.replace(/\/$/, "");
        const mod = (await import(/* @vite-ignore */ `${base}/pagefind/pagefind.js`)) as Pagefind;
        await mod.init();
        return mod;
      } catch (error) {
        console.error("Orbit search: failed to load Pagefind", error);
        return null;
      }
    }

    async onInput() {
      const query = this.input.value.trim();
      const seq = ++this.searchSeq;
      this.results = [];
      this.rendered = 0;
      this.resultsEl.innerHTML = "";
      this.loadMoreBtn.hidden = true;

      if (!query) {
        this.statusEl.textContent = "";
        return;
      }

      this.statusEl.textContent = this.t.searching;
      const pagefind = await this.ensurePagefind();
      if (seq !== this.searchSeq) return; // a newer keystroke superseded this one
      if (!pagefind) return;

      const search = await pagefind.debouncedSearch(query, {}, 250);
      if (seq !== this.searchSeq) return;
      if (search === null) return; // pagefind's own debounce says this one's stale too

      this.results = search.results;
      this.statusEl.textContent =
        this.results.length === 0 ? this.t.noResults(query) : this.t.resultsFor(this.results.length, query);
      await this.renderNextBatch();
    }

    async renderNextBatch() {
      const batch = this.results.slice(this.rendered, this.rendered + BATCH_SIZE);
      const stripTrailingSlash = this.dataset.stripTrailingSlash !== undefined;
      const formatUrl = (url: string) => (stripTrailingSlash ? url.replace(/(.)\/(#.*)?$/, "$1$2") : url);

      for (const result of batch) {
        const data = await result.data();
        const article = document.createElement("article");
        article.className = "orbit-search-result";

        const titleLink = document.createElement("a");
        titleLink.href = formatUrl(data.url);
        titleLink.className = "orbit-search-result-title";
        titleLink.textContent = data.meta.title ?? data.url;
        article.appendChild(titleLink);

        if (data.sub_results.length > 1 || (data.sub_results[0] && data.sub_results[0].url !== data.url)) {
          for (const sub of data.sub_results) {
            const subEl = document.createElement("a");
            subEl.href = formatUrl(sub.url);
            subEl.className = "orbit-search-sub-result";
            const subTitle = document.createElement("span");
            subTitle.className = "orbit-search-sub-result-title";
            subTitle.textContent = sub.title;
            const excerpt = document.createElement("span");
            excerpt.className = "orbit-search-excerpt";
            excerpt.innerHTML = sub.excerpt;
            subEl.append(subTitle, excerpt);
            article.appendChild(subEl);
          }
        } else if (data.excerpt) {
          const excerpt = document.createElement("p");
          excerpt.className = "orbit-search-excerpt";
          excerpt.innerHTML = data.excerpt;
          article.appendChild(excerpt);
        }

        this.resultsEl.appendChild(article);
      }

      this.rendered += batch.length;
      this.loadMoreBtn.hidden = this.rendered >= this.results.length;
      if (!this.loadMoreBtn.hidden) this.loadMoreBtn.textContent = this.t.loadMore;
    }
  }

  if (!customElements.get("orbit-search")) {
    customElements.define("orbit-search", OrbitSearch);
  }

  // Close on result click / any other in-page navigation, and reset the
  // field so re-opening starts blank rather than mid-scroll on stale
  // results.
  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement | null;
    if (!target?.closest(".orbit-search-result-title, .orbit-search-sub-result")) return;
    document.querySelector("orbit-modal")?.removeAttribute("open");
  });
</script>

<style>
  /* <orbit-search> (this whole component's own custom-element tag) sits
     as a direct child of Header.astro's `.sl-flex` search column — a
     row flex container. A block-level flex item doesn't stretch along
     the main axis on its own (unlike normal block flow, where a block
     element fills its parent's width by default); without flex: 1 here
     it shrinks to fit its content instead, and the trigger's own
     width: 100% below then resolves against that shrunk size instead
     of the column's actual available width. */
  orbit-search {
    display: block;
    flex: 1;
    min-width: 0;
  }

  .orbit-search-trigger {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    width: 100%;
    max-width: 42rem;
    margin: 0 auto;
    height: 2.5rem;
    padding-inline: var(--space-md);
    box-sizing: border-box;
    border: 1px solid var(--color-field-border);
    border-radius: var(--radius-md);
    background: var(--color-field-background);
    color: var(--color-text-muted);
    font-family: var(--typography-font-family), sans-serif;
    font-size: var(--control-font-size-sm);
    cursor: pointer;
    transition: border-color calc(var(--motion-duration-color) * 1ms);
  }

  .orbit-search-trigger:hover {
    border-color: var(--color-field-border-focus);
  }

  .orbit-search-trigger .icon {
    width: var(--icon-size-sm);
    height: var(--icon-size-sm);
    flex-shrink: 0;
  }

  .orbit-search-trigger .placeholder {
    flex: 1;
    text-align: left;
  }

  .orbit-search-trigger .shortcut {
    display: flex;
    gap: 0.25em;
  }

  .orbit-search-trigger kbd kbd {
    padding-inline: 0.375rem;
    border-radius: var(--radius-sm);
    background: var(--color-surface-background-secondary);
    color: var(--color-text-secondary);
    font-family: inherit;
    font-size: 0.75rem;
  }

  .orbit-search-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    /* Fills whatever content-box width orbit-modal's dialog actually
       has (max-width: var(--modal-max-width) minus its own padding +
       border) — a fixed px/rem value here would need to guess that
       padding/border math exactly right, and disagreeing by even a
       couple px is what caused the dialog to gain a horizontal
       scrollbar. min(100%, 90vw) still caps it on narrow viewports. */
    width: min(100%, 90vw);
    /* height, not max-height — the box has to be this size the instant
       it opens, empty, or it visibly grows the moment the first
       keystroke's results land. A fixed footprint means the modal
       never resizes after open; .results scrolls inside it instead. */
    height: min(32rem, 80vh);
    overflow-x: hidden;
  }

  .status {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--control-font-size-sm);
  }

  .results {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    gap: var(--space-md);
    min-width: 0;
    overflow-x: hidden;
    overflow-y: auto;
  }

  [data-search-load-more] {
    align-self: center;
  }
</style>

<style is:global>
  /* Everything below only ever exists as DOM nodes created by
     renderNextBatch() in the <script> above (document.createElement,
     never present at build time) — Astro's scoped styles only stamp
     their data-astro-cid-* attribute onto elements that exist in this
     file's own template at build time, so a scoped rule here would
     silently never match anything JS creates later. Global, but every
     selector is specific enough (.orbit-search-* / .result* / .excerpt)
     that it won't leak onto unrelated markup elsewhere on the site. */
  .orbit-search-result {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    min-width: 0;
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-surface-border-strong);
  }

  .orbit-search-result:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .orbit-search-result-title {
    display: block;
    color: var(--color-text-primary);
    font-weight: var(--typography-weight-bold);
    font-size: var(--control-font-size-md);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .orbit-search-result-title:hover {
    color: var(--color-primary-on-light-text);
  }

  .orbit-search-sub-result {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    padding: var(--space-xs) var(--space-sm);
    margin-inline: calc(var(--space-sm) * -1);
    border-radius: var(--radius-sm);
    text-decoration: none;
  }

  .orbit-search-sub-result:hover {
    background: var(--color-surface-background-secondary);
  }

  .orbit-search-sub-result-title {
    display: block;
    color: var(--color-text-secondary);
    font-weight: var(--typography-weight-bold);
    font-size: var(--control-font-size-sm);
    overflow-wrap: anywhere;
  }

  .orbit-search-excerpt {
    display: block;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--control-font-size-sm);
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  .orbit-search-excerpt mark {
    background: none;
    color: var(--color-primary-on-light-text);
    font-weight: var(--typography-weight-bold);
  }
</style>
