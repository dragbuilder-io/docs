---
// Overrides Starlight's default <ThemeSelect> (a native <select> with an
// icon overlay) with a 3-way segmented control — Dark/Light/Auto as
// three always-visible buttons instead of a collapsed dropdown, active
// one filled with color.primary.on-light-text (lime dark / navy light),
// same fill/content pairing OrbitRadio/OrbitSwitch use for their own
// "on" state. Ported from orbit-docs' own ThemeSelect.astro (the
// design-system's own docs site) — same component, same tokens.
//
// The theme-switching logic itself is a straight port of Starlight's own
// (ThemeSelect.astro + ThemeProvider.astro) — same localStorage key
// ("starlight-theme"), same 'auto' semantics (stored as '', resolved via
// prefers-color-scheme, tracked live) — so this stays interchangeable
// with Starlight's FOUC-prevention inline script in ThemeProvider.astro,
// which isn't overridden and still runs as-is on every page load.
---

<orbit-theme-select class="orbit-theme-select" role="group" aria-label="Theme">
  <button type="button" data-value="dark" aria-label="Dark">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M21.64 13a1 1 0 0 0-1.05-.14 8.049 8.049 0 0 1-3.37.73 8.15 8.15 0 0 1-8.14-8.1 8.59 8.59 0 0 1 .25-2A1 1 0 0 0 8 2.36a10.14 10.14 0 1 0 14 11.69 1 1 0 0 0-.36-1.05Zm-9.5 6.69A8.14 8.14 0 0 1 7.08 5.22v.27a10.15 10.15 0 0 0 10.14 10.14 9.784 9.784 0 0 0 2.1-.22 8.11 8.11 0 0 1-7.18 4.32v-.04Z"
      ></path>
    </svg>
  </button>
  <button type="button" data-value="light" aria-label="Light">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M5 12a1 1 0 0 0-1-1H3a1 1 0 0 0 0 2h1a1 1 0 0 0 1-1Zm.64 5-.71.71a1 1 0 0 0 0 1.41 1 1 0 0 0 1.41 0l.71-.71A1 1 0 0 0 5.64 17ZM12 5a1 1 0 0 0 1-1V3a1 1 0 0 0-2 0v1a1 1 0 0 0 1 1Zm5.66 2.34a1 1 0 0 0 .7-.29l.71-.71a1 1 0 1 0-1.41-1.41l-.66.71a1 1 0 0 0 0 1.41 1 1 0 0 0 .66.29Zm-12-.29a1 1 0 0 0 1.41 0 1 1 0 0 0 0-1.41l-.71-.71a1.004 1.004 0 1 0-1.43 1.41l.73.71ZM21 11h-1a1 1 0 0 0 0 2h1a1 1 0 0 0 0-2Zm-2.64 6A1 1 0 0 0 17 18.36l.71.71a1 1 0 0 0 1.41 0 1 1 0 0 0 0-1.41l-.76-.66ZM12 6.5a5.5 5.5 0 1 0 5.5 5.5A5.51 5.51 0 0 0 12 6.5Zm0 9a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7Zm0 3.5a1 1 0 0 0-1 1v1a1 1 0 0 0 2 0v-1a1 1 0 0 0-1-1Z"
      ></path>
    </svg>
  </button>
  <button type="button" data-value="auto" aria-label="Auto">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M12 3a9 9 0 0 1 0 18Z" fill="currentColor" stroke="none"></path>
    </svg>
  </button>
</orbit-theme-select>

<script>
  type Theme = "auto" | "dark" | "light";
  const storageKey = "starlight-theme";

  const parseTheme = (theme: unknown): Theme =>
    theme === "auto" || theme === "dark" || theme === "light" ? theme : "auto";

  const loadTheme = (): Theme =>
    parseTheme(typeof localStorage !== "undefined" && localStorage.getItem(storageKey));

  function storeTheme(theme: Theme): void {
    if (typeof localStorage !== "undefined") {
      localStorage.setItem(storageKey, theme === "light" || theme === "dark" ? theme : "");
    }
  }

  const getPreferredColorScheme = (): Theme =>
    matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";

  class OrbitThemeSelect extends HTMLElement {
    constructor() {
      super();
      const buttons = Array.from(this.querySelectorAll<HTMLButtonElement>("button"));

      const applyTheme = (theme: Theme, persist: boolean): void => {
        document.documentElement.dataset.theme = theme === "auto" ? getPreferredColorScheme() : theme;
        if (persist) storeTheme(theme);
        for (const button of buttons) {
          button.setAttribute("aria-pressed", String(button.dataset.value === theme));
        }
      };

      applyTheme(loadTheme(), false);

      for (const button of buttons) {
        button.addEventListener("click", () => applyTheme(parseTheme(button.dataset.value), true));
      }

      matchMedia("(prefers-color-scheme: light)").addEventListener("change", () => {
        if (loadTheme() === "auto") applyTheme("auto", false);
      });
    }
  }

  if (!customElements.get("orbit-theme-select")) {
    customElements.define("orbit-theme-select", OrbitThemeSelect);
  }
</script>

<style>
  .orbit-theme-select {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 2px;
    border-radius: var(--radius-full);
    background: var(--color-field-background);
    border: 1px solid var(--color-field-border);
  }

  .orbit-theme-select button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border: none;
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition:
      background-color calc(var(--motion-duration-color) * 1ms),
      color calc(var(--motion-duration-color) * 1ms);
  }

  .orbit-theme-select button svg {
    width: 1rem;
    height: 1rem;
  }

  .orbit-theme-select button:hover:not([aria-pressed="true"]) {
    color: var(--color-text-primary);
  }

  .orbit-theme-select button[aria-pressed="true"] {
    background: var(--color-primary-on-light-text);
    /* --color-primary-on-navy-text needs design-tokens >=0.1.31 (this
       repo's package.json declares that range, but the installed
       node_modules/package-lock.json are still pinned to 0.1.29 —
       re-running `npm install` once the private registry token is
       available picks up the real token and makes these fallbacks
       inert). Until then: dark mode's active pill is still lime, so its
       correct value is the same as on-lime-text; light mode's pill goes
       navy, so it needs plain white — see nova's tokens.css for the
       upstream values these fallbacks mirror. */
    color: var(--color-primary-on-navy-text, var(--color-primary-on-lime-text));
  }

  :root[data-theme="light"] .orbit-theme-select button[aria-pressed="true"] {
    color: var(--color-primary-on-navy-text, #ffffff);
  }
</style>
